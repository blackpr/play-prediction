# Production Environment Variables Template
# Copy these to your CapRover app environment variables

# Supabase Configuration (Production Project)
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-production-project.supabase.co:5432/postgres

# Redis Configuration (CapRover Redis App)
REDIS_URL=redis://srv-captain--redis-production:6379

# Application Configuration
PORT=4000
NODE_ENV=production
LOG_LEVEL=warn

# Worker Configuration
WORKER_CONCURRENCY=10
ENABLE_WORKER=true

# Business Logic
REGISTRATION_BONUS_AMOUNT=100000000

# Optional: Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000
